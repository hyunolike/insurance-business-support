# ─────────────────────────────────────────────────────────────────────────────
# 로컬 개발 환경 변수
#
#   cp .env.example .env
#
# .env 는 .gitignore 에 있다. 절대 커밋하지 않는다.
#
# ★ DB_PASSWORD 와 POLICY_ENCRYPTION_KEY 에는 기본값이 없다.
#   설정하지 않으면 애플리케이션이 기동에 실패한다. 의도된 동작이다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 필수 ─────────────────────────────────────────────────────────────────────
DB_PASSWORD=localdev
POLICY_ENCRYPTION_KEY=local-dev-key-do-not-use-in-production

# ── 선택 (기본값 있음) ────────────────────────────────────────────────────────
# claims-platform 과 포트가 다르다. 두 서비스를 동시에 띄워야 하기 때문이다.
SERVER_PORT=8081

DB_URL=jdbc:postgresql://localhost:5433/policy
DB_USERNAME=policy
DB_POOL_SIZE=10

REDIS_HOST=localhost
REDIS_PORT=6380

# Kafka는 claims-platform 의 compose가 띄운 브로커를 공유한다
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=business-support

# 언더라이팅 룰셋 버전. 과거 인수 심사는 당시 버전으로 재현되어야 한다.
UW_RULESET_VERSION=2026.01

# 부담보를 이 개수 넘게 붙이면 자동 인수하지 않고 회부한다 (U-CND-080)
UW_MAX_AUTO_EXCLUSIONS=2

LOG_LEVEL=DEBUG
